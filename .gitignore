# Secrets. The scaffolder's own next-steps say `cp .env.example .env`, and it
# ships no .gitignore — so this file is the only thing standing between a
# `git add -A` and a committed APP_SECRET_KEY / JWT_SECRET /
# SECRET_ENCRYPTION_KEY.
.env
.env.*
!.env.example

# Local overnight-run overrides (deploy host lives here, not in the tracked
# .overnight.conf).
.overnight.local.conf

# Node
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# Extracted TLS material (a copy of the old service.s ACME cert).
certs/

# This stack's own ACME store, after the hand-over. It holds the account
# private key and every issued certificate's private key — the one file in
# the deployment whose loss means re-issuing and whose disclosure means
# somebody else can speak as the service.
letsencrypt/
