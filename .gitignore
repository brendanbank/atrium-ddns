# Secrets. The scaffolder's own next-steps say `cp .env.example .env`, and it
# ships no .gitignore — so this file is the only thing standing between a
# `git add -A` and a committed APP_SECRET_KEY / JWT_SECRET /
# SECRET_ENCRYPTION_KEY.
.env
.env.*
!.env.example

# Local overnight-run overrides (deploy host lives here, not in the tracked
# .overnight.conf).
.overnight.local.conf

# Node
node_modules/
dist/
*.tsbuildinfo

# Playwright artefacts. `test-results/` holds the strip screenshots the
# specs write on every run, plus failure screenshots and traces — a failed
# run's screenshot is a full page, so it can carry a session's email
# address, and none of it belongs in the history. The one image that IS
# committed is `docs/ops/img/resolution-strip.png`, checked by eye first.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# Extracted TLS material (a copy of the old service.s ACME cert).
certs/

# This stack's own ACME store, after the hand-over. It holds the account
# private key and every issued certificate's private key — the one file in
# the deployment whose loss means re-issuing and whose disclosure means
# somebody else can speak as the service.
letsencrypt/

# Conductor's per-workspace scratch directory: agent notes, todo lists,
# whatever is mid-thought. It was ignored through `.git/info/exclude`, which
# is machine-local — so it protected this checkout and nobody else's. Tracked
# here instead now that the repository is public and clones are other people's.
.context/
