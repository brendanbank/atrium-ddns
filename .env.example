# This file is an EXAMPLE, and three of its values are placeholders rather
# than defaults — `replace-me-with-openssl-rand-hex-*` is not a valid input to
# anything. `cp .env.example .env` therefore produces a stack that cannot run:
# atrium checks SECRET_ENCRYPTION_KEY's shape in every environment, so the api
# raises at import, `restart: unless-stopped` restarts it, and it raises again.
#
# Use `make env` instead. It copies this file and mints the three values with
# `openssl rand -hex`. `make up` refuses on a `.env` still carrying them, and
# names the key and the fix (scripts/check-env.sh).
#
# No working key is committed here on purpose: a shipped valid secret is a
# credential in the repository, and every dev stack in the world would share
# it. `make check-env-self-test` asserts this file never passes the guard.

ENVIRONMENT=dev
APP_TIMEZONE=UTC

# Long random strings. `openssl rand -hex 48` for each. `make env` fills them.
APP_SECRET_KEY=replace-me-with-openssl-rand-hex-48
JWT_SECRET=replace-me-with-openssl-rand-hex-48
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Secret-at-rest key for encrypted host columns (atrium >= 0.27,
# `app.host_sdk.crypto`). 32 bytes hex: `openssl rand -hex 32`.
# Deliberately NOT derived from APP_SECRET_KEY or JWT_SECRET — rotating
# a signing secret must not destroy stored DNS-provider credentials.
# Back it up outside the database dump: lose it and every stored
# backend credential is unrecoverable. A prod stack refuses to boot
# without it, even with no encrypted columns declared.
SECRET_ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# Host ports. Both are project-specific so several atrium hosts can run
# side by side on one dev box — 8053 and 13353 nod at DNS/53. Change
# them if they collide with something you already run.
API_HOST_PORT=8053
MYSQL_HOST_PORT=13353

# Which host address the api's published port binds to — compose reads it as
# the `${API_BIND}:` prefix on that mapping. The prefix does more than it
# looks: Docker binds BOTH address families only when no host address is
# given, so naming one here pins the api to IPv4 even with `enable_ipv6: true`
# on the network. That is intended; the public path is the `tls` proxy below,
# whose mapping is left unprefixed on purpose.
#
# 0.0.0.0 is right for a dev box and wrong for anything reachable. atrium
# speaks plain HTTP and DynDNS clients authenticate with HTTP Basic, so a
# published port on a public interface is every device secret on the wire in
# base64. On a server set this to 127.0.0.1 and put TLS in front, or delete
# the mapping from compose.yaml entirely.
API_BIND=0.0.0.0

# The public URL the browser hits. Used in email links. Must include
# API_HOST_PORT in dev.
APP_BASE_URL=http://localhost:8053

# MySQL. The container talks to mysql:3306 on the compose network;
# MYSQL_HOST_PORT above is only what the host machine sees.
MYSQL_ROOT_PASSWORD=root-pw-change-me
MYSQL_DATABASE=atrium_ddns
MYSQL_USER=atrium_ddns
MYSQL_PASSWORD=db-pw-change-me
DATABASE_URL=mysql+aiomysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}

# WebAuthn — the host the credential is bound to (no scheme/port) and
# the full origin the registration ceremony runs from. localhost is
# fine for dev; switch to your real hostname in prod. The origin must
# match APP_BASE_URL exactly, port included, or registration fails.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Atrium DDNS"
WEBAUTHN_ORIGIN=http://localhost:8053

# Branding. What the SPA calls itself — the browser tab title, the shell
# header and the login page all read this one value (atrium's
# `BrandConfig.name`; there is no separate tab-title field). Applied by
# `make seed-brand`, which is re-runnable, so this is the declared value
# and the database follows it rather than the other way round.
#
# `0001_init` seeds the same default so a fresh database is already correct
# before anything is run; the make target exists because an alembic
# revision runs once per database and cannot correct an existing one.
#
# Not reachable from here: the atrium image's `index.html` ships a literal
# `<title>Atrium</title>`. A browser replaces it from BRAND_NAME as soon as
# /api/app-config resolves, but the bytes the server sends do not change.
BRAND_NAME=Atrium Ddns
# Mantine primary colour, applied as brand.overrides.primaryColor.
BRAND_PRIMARY_COLOR=blue

# Mail. `console` prints to stdout; switch to `smtp` and fill
# SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD in prod.
MAIL_BACKEND=console
MAIL_FROM=no-reply@example.com

# Pin the atrium base image. Always X.Y.Z, never a floating X.Y: this
# file is the canonical pin the release watcher reads, and it compares
# against an upstream release tag, which is always three parts. 0.27 is
# the floor — it carries the secret-at-rest primitive this host stores
# provider credentials with.
#
# The same tag appears in Dockerfile, compose.yaml, .github/workflows/ci.yml
# and README.md, and the three @brendanbank/atrium-* npm packages carry the
# matching version in frontend/package.json. They move together or not at
# all; .github/workflows/atrium-watch.yml is what moves them.
ATRIUM_IMAGE=ghcr.io/brendanbank/atrium:0.30.0

# Which Dockerfile stage the image is built from. `runtime` is the app;
# `dev` is `FROM runtime` plus pytest and xdist. The default is the superset
# on purpose — the test targets then run inside the same image the stack
# runs, rather than a near-copy of it.
#
# Left at `dev`, a server ships test tooling it will never call. Set it to
# `runtime` there. There is no third value, and nothing else changes.
# Irrelevant if you run the published image (COMPOSE_FILE at the end of this
# file), because that path never builds.
#ATRIUM_BUILD_TARGET=runtime

# --- The TLS terminator (the `tls` profile) ---------------------------------
# A Traefik in front of the api, defined in the base `compose.yaml` behind
# `profiles: [tls]` — so none of this reaches a dev stack until the profile is
# selected. It serves a certificate EXTRACTED from the old service's ACME
# store rather than running ACME itself; scripts/extract-acme-cert.sh says why,
# and the copy goes stale when the real writer renews (`make tls-refresh`).
# The ACME block below is the overlay that eventually retires this.
#
# Two ways to select the profile, and they are not equivalent. `make tls-up`
# passes `--profile tls` and extracts the certificate first, which is the
# supported path. Setting COMPOSE_PROFILES here instead makes a plain
# `make up` carry the proxy along — what you want on a server whose restarts
# you do not drive by hand — but nothing extracts a certificate for you, and a
# proxy that starts against an empty ./certs serves Traefik's own self-signed
# default rather than failing. Run `make tls-extract` once before enabling it.
#COMPOSE_PROFILES=tls

# The host port the terminator publishes. Project-specific for the reason
# API_HOST_PORT is, and unprivileged, so the proxy needs no capability the api
# does not already have. This mapping is deliberately unprefixed — there is no
# API_BIND equivalent — so unlike the api's port it binds both address
# families. That is the public path, and it is meant to be reachable.
#
# The ACME overlay below replaces this mapping outright (`ports: !override`)
# and publishes 80/443 through ACME_HTTP_PUBLISH / ACME_HTTPS_PUBLISH, so
# under that overlay this value is ignored rather than merged.
#TLS_HOST_PORT=8443

# Where the proxy looks for cert.pem and key.pem. Read by compose.yaml and by
# compose.acme.yaml (which keeps the extracted copy as its fallback) — but NOT
# by the Makefile, which carries its own `TLS_CERT_DIR ?= ./certs` and never
# reads this file. The two defaults agree, so they can only diverge if you
# change one: set it here alone and `make tls-extract` writes the certificate
# to ./certs while the proxy mounts an empty directory elsewhere and quietly
# serves its self-signed default. Change both, or neither.
#TLS_CERT_DIR=./certs

# --- The ACME hand-over -----------------------------------------------------
# Read ONLY by `compose.acme.yaml`, the overlay that runbook step 5.4(c)
# applies. The base `compose.yaml` never looks at any of them, so leaving this
# block as it stands costs a dev stack nothing.
#
# None of the three has a default, on purpose: the overlay refuses to load at
# all when one is missing, naming it. A wrong value here is invisible for
# weeks, because the extracted fallback certificate goes on terminating TLS
# while it is wrong.

# The public hostname the certificate is for. It becomes Traefik's router rule
# through the file provider's own templating (see
# infra/traefik/dynamic-acme.yml), which is what keeps the real name out of
# every tracked file in this repository. Copy the incumbent's value; do not
# type it from memory.
TRAEFIK_HOSTNAME=ddns.example.invalid

# Contact address on the ACME account. Also the incumbent's.
LETSENCRYPT_EMAIL=ops@example.invalid

# The ACME directory, and the one line in this file worth reading twice.
#
# Unset, the incumbent's compose defaults this to **staging** and Traefik's
# own default is **production** — two different silent answers to the same
# omission. A stack that lands on staging gets certificates no browser trusts,
# and the symptom does not appear until the extracted fallback is out of the
# way. So it is mandatory, and it is written out in full rather than named by
# a flag.
#
# production (what a cutover uses):
LETSENCRYPT_CASERVER=https://acme-v02.api.letsencrypt.org/directory
# staging (what a rehearsal uses — rate limits are generous, the certificates
# are untrusted, and that is the point):
# LETSENCRYPT_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Where this stack's OWN ACME store lives, and what the hand-over publishes.
# The defaults are the production values; they exist as variables so the gate
# test (`make test-acme-handover`) can stand the shipped service up on a
# throwaway port pair rather than testing a copy of it.
# ACME_STORE_DIR=./letsencrypt
# ACME_HTTP_PUBLISH=80
# ACME_HTTPS_PUBLISH=443

# Enable the frozen compat table's scripted DNS backends (`stub1`..`stub3`)
# and the `make seed-compat-fixture` target. Set to exactly "1" to open it;
# it is refused regardless when ENVIRONMENT=prod, because the stub answers
# `good` without contacting a nameserver. Leave unset on anything real.
ATRIUM_DDNS_COMPAT_STUB=

# --- Running the published image instead of building ------------------------
# Uncomment both on a server. `docker compose` reads COMPOSE_FILE from this
# file, so `make up` then pulls the released image and never builds. Pin a
# version; `latest` makes what runs depend on when you last restarted.
#COMPOSE_FILE=compose.yaml:compose.prod.yaml
#DDNS_IMAGE=ghcr.io/brendanbank/atrium-ddns:v0.1.3

# --- Log shipping to Loki (optional) ----------------------------------------
# Read ONLY by `compose.loki.yaml` — the untracked copy of
# compose.loki.yaml.example — which no stack loads until you add it to the
# COMPOSE_FILE list above:
#
#   COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.loki.yaml
#
# That is the whole of the wiring and it is also the trap. Compose auto-merges
# `docker-compose.override.yml` only when no explicit file list is given, so a
# COMPOSE_FILE that omits the overlay leaves it a file on disk that nothing
# reads — no error, and `docker compose config` renders the stack unchanged.
#
# Three things about the value itself:
#
#   1. It must be the FULL push endpoint, ending `/loki/api/v1/push`. A bare
#      base URL 404s on every push and stores nothing, with no error in
#      `docker logs` and none in the daemon journal. Probe it before trusting
#      it — a 4xx that is NOT 404 means the endpoint is there:
#        curl -o /dev/null -w '%{http_code}\n' -XPOST -d '{}' "$LOKI_URL"
#   2. Basic auth goes in the userinfo of this URL and nowhere else — the Loki
#      Docker driver has no loki-username / loki-password options. Percent-
#      encode reserved characters in the password; a raw `@` splits the
#      authority and the driver then fails to resolve a host that does not
#      exist.
#   3. It is NOT confidential to the host. Log options are stored verbatim in
#      the container config, so the full URL — password included — is readable
#      via `docker inspect` and `docker compose config` by anyone in the docker
#      group. Scope the credential to a class that may only push.
#
# The overlay uses `${LOKI_URL:?...}`, so once it is in COMPOSE_FILE the stack
# refuses to load without this variable rather than shipping to nowhere.
#LOKI_URL=https://CLASS:PASSWORD@loki.example.invalid/loki/api/v1/push
