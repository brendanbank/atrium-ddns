ENVIRONMENT=dev
APP_TIMEZONE=UTC

# Long random strings. `openssl rand -hex 48` for each.
APP_SECRET_KEY=replace-me-with-openssl-rand-hex-48
JWT_SECRET=replace-me-with-openssl-rand-hex-48
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Secret-at-rest key for encrypted host columns (atrium >= 0.27,
# `app.host_sdk.crypto`). 32 bytes hex: `openssl rand -hex 32`.
# Deliberately NOT derived from APP_SECRET_KEY or JWT_SECRET — rotating
# a signing secret must not destroy stored DNS-provider credentials.
# Back it up outside the database dump: lose it and every stored
# backend credential is unrecoverable. A prod stack refuses to boot
# without it, even with no encrypted columns declared.
SECRET_ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# Host ports. Both are project-specific so several atrium hosts can run
# side by side on one dev box — 8053 and 13353 nod at DNS/53. Change
# them if they collide with something you already run.
API_HOST_PORT=8053
MYSQL_HOST_PORT=13353

# The public URL the browser hits. Used in email links. Must include
# API_HOST_PORT in dev.
APP_BASE_URL=http://localhost:8053

# MySQL. The container talks to mysql:3306 on the compose network;
# MYSQL_HOST_PORT above is only what the host machine sees.
MYSQL_ROOT_PASSWORD=root-pw-change-me
MYSQL_DATABASE=atrium_ddns
MYSQL_USER=atrium_ddns
MYSQL_PASSWORD=db-pw-change-me
DATABASE_URL=mysql+aiomysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}

# WebAuthn — the host the credential is bound to (no scheme/port) and
# the full origin the registration ceremony runs from. localhost is
# fine for dev; switch to your real hostname in prod. The origin must
# match APP_BASE_URL exactly, port included, or registration fails.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Atrium DDNS"
WEBAUTHN_ORIGIN=http://localhost:8053

# Branding. What the SPA calls itself — the browser tab title, the shell
# header and the login page all read this one value (atrium's
# `BrandConfig.name`; there is no separate tab-title field). Applied by
# `make seed-brand`, which is re-runnable, so this is the declared value
# and the database follows it rather than the other way round.
#
# `0001_init` seeds the same default so a fresh database is already correct
# before anything is run; the make target exists because an alembic
# revision runs once per database and cannot correct an existing one.
#
# Not reachable from here: the atrium image's `index.html` ships a literal
# `<title>Atrium</title>`. A browser replaces it from BRAND_NAME as soon as
# /api/app-config resolves, but the bytes the server sends do not change.
BRAND_NAME=Atrium Ddns
# Mantine primary colour, applied as brand.overrides.primaryColor.
BRAND_PRIMARY_COLOR=blue

# Mail. `console` prints to stdout; switch to `smtp` and fill
# SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD in prod.
MAIL_BACKEND=console
MAIL_FROM=no-reply@example.com

# Pin the atrium base image. X.Y for patch uptake; X.Y.Z for fully
# deterministic deploys. 0.27 is the floor: it carries the
# secret-at-rest primitive this host stores provider credentials with.
ATRIUM_IMAGE=ghcr.io/brendanbank/atrium:0.28

# Enable the frozen compat table's scripted DNS backends (`stub1`..`stub3`)
# and the `make seed-compat-fixture` target. Set to exactly "1" to open it;
# it is refused regardless when ENVIRONMENT=prod, because the stub answers
# `good` without contacting a nameserver. Leave unset on anything real.
ATRIUM_DDNS_COMPAT_STUB=
