{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // `@types/node` is not picked up automatically under TypeScript 7 +
    // `moduleResolution: bundler`: `--traceResolution` reports
    // *"Skipping module 'node:fs' that looks like an absolute URI"* and
    // the import fails with TS2591 even with the package installed.
    // Naming it here is what makes the `node:` specifiers resolve. Only
    // the tests reach for them — `src/test/design.test.ts` reads
    // `ddns.css` off disk, because vitest's default `css: false` stubs
    // CSS modules and `?raw` would hand the guards an empty string.
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `tests-e2e` is in here on purpose: `pnpm typecheck` is in the gate,
  // and a Playwright spec that does not compile is a spec that fails at
  // run time on a stack someone waited five minutes for. The vite lib
  // build reads `src/main.tsx` alone, so nothing here reaches the
  // shipped bundle.
  "include": ["src", "tests-e2e", "playwright.config.ts"]
}
